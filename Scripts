# ------------------------------------------------------------
# MEASURE AUTHORIZED ACCESS
# Enable successful System Event auditing
# ------------------------------------------------------------

$gpo = Get-SDMgpobject `
    -gpoName "gpo://$($gpo.DomainName)/$GPOName" `
    -openByName $true

$secSetting = $gpo.GetObject(
    "Computer Configuration/Windows Settings/Security Settings/Local Policies/Audit Policy"
)

$settingName = "Audit system events"

$setValue = [GPOSDK.AuditPolicyValue]"Success"

$setting = $secSetting.Settings.ItemByName($settingName)

$setting.Put("Defined", 1)
$setting.Put("Value", $setValue)

$setting.Save()

Write-Host "Successful system-event auditing has been enabled."
Write-Host "Authorized access activity can now be monitored through the audit events."
